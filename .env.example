HERE_API_KEY=
WEATHERAPI_KEY=
# CityFlow backend (backend/), e.g. https://cityflow-api.onrender.com.
# Local dev defaults to http://localhost:8000. Required for a deployed build:
# without it the site shows that it isn't connected to its backend.
VITE_CITYFLOW_API_URL=

# Incident photo checks: put GEMINI_API_KEY=... in backend/.env (not here).
# See backend/README.md.
